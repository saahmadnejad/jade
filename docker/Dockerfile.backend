FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY backend/pom.xml ./
COPY backend/fipa ./fipa
COPY backend/llm ./llm
COPY backend/jade ./jade
COPY backend/examples ./examples
RUN mvn -B -DskipTests package

FROM docker.io/library/eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /build/jade/target/jade-*.jar app.jar
COPY --from=build /build/examples/target/examples-*.jar examples.jar
COPY --from=build /build/llm/target/llm-*.jar llm.jar
RUN apk add --no-cache curl libstdc++ libgcc git npm nodejs bash python3 py3-pip tar gzip shadow procps \
    && curl -fsSL https://github.com/anomalyco/opencode/releases/download/v1.18.25/opencode-linux-x64-musl.tar.gz \
      -o /tmp/opencode.tar.gz && mkdir -p /opt/opencode && tar -xzf /tmp/opencode.tar.gz -C /opt/opencode \
    && ln -s /opt/opencode/opencode /usr/local/bin/opencode \
    || echo "WARNING: opencode install failed"
RUN mkdir -p /workspace /app/conf /app/logs && chmod 777 /workspace /app/conf /app/logs
RUN export SHELL=/bin/sh; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v2.98.0/gh_2.98.0_linux_amd64.tar.gz" \
      -o /tmp/gh.tar.gz && tar -xzf /tmp/gh.tar.gz -C /tmp && mv /tmp/gh_2.98.0_linux_amd64 /opt/gh && \
    ln -s /opt/gh/bin/gh /usr/local/bin/gh || \
    echo "WARNING: gh install skipped"
EXPOSE 1099 8080
CMD ["java", "-cp", "app.jar:examples.jar:llm.jar", "io.donbee.jade.Boot", "-host", "localhost", "-local-host", "localhost"]
