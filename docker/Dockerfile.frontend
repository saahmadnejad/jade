FROM docker.io/library/node:20-alpine AS base
RUN npm install -g pnpm@9

FROM base AS builder
WORKDIR /app
COPY frontend/package.json frontend/pnpm-workspace.yaml ./
COPY frontend/apps/frontend/package.json ./apps/frontend/
COPY frontend/packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile=false
COPY frontend/apps/frontend/ ./apps/frontend/
COPY frontend/packages/shared/ ./packages/shared/
WORKDIR /app/apps/frontend
RUN pnpm build

FROM docker.io/library/nginx:alpine AS runtime
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
