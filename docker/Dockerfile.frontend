FROM docker.io/library/node:20-alpine AS base
RUN npm install -g pnpm@9

FROM base AS builder
WORKDIR /app
COPY frontend/package.json frontend/pnpm-workspace.yaml ./
COPY frontend/apps/webapp/package.json ./apps/webapp/
COPY frontend/packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile=false
COPY frontend/apps/webapp/ ./apps/webapp/
COPY frontend/packages/shared/ ./packages/shared/
WORKDIR /app/apps/webapp
RUN pnpm build

FROM docker.io/library/nginx:alpine AS runtime
COPY --from=builder /app/apps/webapp/dist /usr/share/nginx/html
# Template is processed by the nginx image entrypoint (envsubst).
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 makes it inject the container
# network's DNS servers into ${NGINX_LOCAL_RESOLVERS}, so nginx can
# re-resolve the backend service on every request.
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
