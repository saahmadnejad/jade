# Copy this file to secrets-local.properties and fill in your values.
# The real secrets-local.properties is gitignored (see ADR-0002).
#
# LLM provider is NOT configured here: the workspace
# opencode.json injects the key from the LLM_API_KEY environment
# variable directly into the opencode CLI (see ADR-0005). Set it with:
#   export LLM_API_KEY=<your-key>  # or deprecated export TOKENROUTER_API_KEY=<key>
# (docker compose passes it through automatically).

# GitHub PAT for publishing team work (optional).
# github.token=github_pat_YOUR-PAT-HERE
