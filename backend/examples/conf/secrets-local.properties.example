# Copy this file to secrets-local.properties and fill in your values.
# The real secrets-local.properties is gitignored (see ADR-0002).
#
# 9router API key — get it from http://localhost:20129/dashboard (Docker)
# or http://localhost:20128/dashboard (local). Required: 9router returns 401 without it.
llm.api.key=sk-9r-YOUR-API-KEY-HERE

# 9router base URL for the langchain4j brain.
# Docker: http://9router:20128/v1
# Local:  http://localhost:20128/v1
llm.base.url=http://9router:20128/v1

# Model selection:
#   Verify what your 9router currently serves (models come and go):
#     curl http://localhost:20128/v1/models   (local)
#     curl http://localhost:20129/v1/models   (Docker)
#   Role agents need a tool-capable model (they call a bash tool);
#   the fallback may be text-only.
llm.model.name=YOUR-MODEL-HERE

# GitHub PAT for publishing team work (optional).
# github.token=github_pat_YOUR-PAT-HERE
